# BSCampus - Environment Variables
# Salin file ini menjadi .env.local untuk development.
# Untuk produksi (Vercel), isi nilai yang sama di Project Settings -> Environment Variables.

# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# ============================================
# Aplikasi
# ============================================
APP_NAME=BSCampus

# URL publik aplikasi. WAJIB HTTPS dan dapat diakses internet untuk produksi,
# karena dipakai sebagai callback_url & redirect_url WaroengPay.
# WaroengPay MENOLAK alamat jaringan privat (localhost, 10.x, 192.168.x).
# Development lokal: webhook tidak akan sampai, status tetap sinkron lewat
# polling GET /api/waroengpay/[id].
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ============================================
# Admin & Auth
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
# Wajib di produksi. Gunakan string acak panjang (minimal 32 karakter).
JWT_SECRET=ganti-dengan-string-acak-panjang

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# ============================================
# Payment Gateway - WaroengPay (QRIS)
# Dashboard: https://waroengpay.com/dashboard
#   Integrasi & API -> Kredensial  (API key)
#   Integrasi & API -> Webhook     (webhook secret)
# Gunakan wp_test_... untuk sandbox, wp_live_... untuk produksi.
# JANGAN pernah menaruh key ini di kode frontend.
# ============================================
WAROENGPAY_API_KEY=wp_test_xxxxxxxxxxxxxxxxxxxxx
WAROENGPAY_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxx
